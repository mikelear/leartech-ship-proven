# The golden mk is fetched per-invocation; a cached copy makes a local pass
# mean "against whatever was cached", which is how a stale linter set gets
# to look like a clean run.
.leartech-go.mk

# Coverage output. A tracked cover.out blew every ai-review model's context
# window on leartech-ba-tool and scored the PR 0/100 for a file that is not
# source. Regenerated by `make test-coverage` on demand.
cover.out
coverage.out
